# Fim de linha LF em toda cópia de trabalho, inclusive no Windows
# (core.autocrlf=true trazia CRLF): os testes que leem a fonte
# (tests/componentes/area-atual.test.js) e o Prettier (endOfLine "lf")
# esperam LF. O repositório já guarda tudo em LF.
* text=auto eol=lf

*.webp binary
*.png binary
*.jpg binary
*.ico binary
*.xlsx binary
*.docx binary
*.pdf binary

# Contagem de linguagens do GitHub (Linguist): só o código que se mantém
# entra na barra "Languages". Não muda nada no build nem nos testes.

# Gerados por script (não se editam à mão)
src/modules/aya-conhecimento-gerado.js linguist-generated=true
src/styles/icones-lucide.css linguist-generated=true
tests/fixtures/** linguist-generated=true

# Dados grandes (contornos, camadas geográficas)
src/lib/mapa-saude-indigena/contornos.js linguist-vendored=true linguist-generated=true
src/modulos/aya/mascote/contornos.ts linguist-vendored=true linguist-generated=true
public/data/** linguist-vendored=true

# Documentação e apoio às migrations: ensaios (begin; ... rollback;),
# rollbacks, migrations descartadas e scripts de correção de dados de uso
# único. supabase/migrations/ segue contando.
docs/** linguist-documentation=true
supabase/ensaios/** linguist-documentation=true
supabase/rollback/** linguist-documentation=true
supabase/descartadas/** linguist-documentation=true
supabase/correcoes/** linguist-documentation=true
