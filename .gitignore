.env
.env.*
!.env.example
node_modules/
dist/
.npm-cache/

# Artefatos das corridas do Playwright
test-results/
playwright-report/

# Obsidian: o vault é a raiz. Versionados app.json (pastas fora do gráfico),
# graph.json (cores e filtros), appearance.json + snippets/ (a lista de arquivos
# só com a documentação); o resto é estado de cada pessoa.
.obsidian/*
!.obsidian/app.json
!.obsidian/graph.json
!.obsidian/appearance.json
!.obsidian/snippets/

# Estado local da CLI do Supabase (contem string de conexao)
supabase/.temp/
.cache/
