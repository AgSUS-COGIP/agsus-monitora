{
  "collapse-filter": true,
  "search": "-path:docs/_templates",
  "showTags": false,
  "showAttachments": false,
  "hideUnresolved": true,
  "showOrphans": true,
  "collapse-color-groups": false,
  "colorGroups": [
    {
      "query": "file:CLAUDE",
      "color": {
        "a": 1,
        "rgb": 9133302
      }
    },
    {
      "query": "path:docs/biblioteca file:modulo-",
      "color": {
        "a": 1,
        "rgb": 3900150
      }
    },
    {
      "query": "path:docs/biblioteca",
      "color": {
        "a": 1,
        "rgb": 1096065
      }
    },
    {
      "query": "path:docs/aya",
      "color": {
        "a": 1,
        "rgb": 16096779
      }
    },
    {
      "query": "path:docs/_arquivo",
      "color": {
        "a": 1,
        "rgb": 7041664
      }
    },
    {
      "query": "path:docs OR file:DESIGN OR file:README OR file:LEIA-ME",
      "color": {
        "a": 1,
        "rgb": 440020
      }
    }
  ],
  "collapse-display": true,
  "showArrow": false,
  "textFadeMultiplier": -2.4,
  "nodeSizeMultiplier": 1.2,
  "lineSizeMultiplier": 0.7,
  "collapse-forces": true,
  "centerStrength": 0.4,
  "repelStrength": 14,
  "linkStrength": 1,
  "linkDistance": 170,
  "scale": 0.45,
  "close": false
